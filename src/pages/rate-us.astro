---
/**
 * Stable redirect target for printed QR codes / NFC tags. The physical tag
 * points here forever; the review destination can be swapped later without
 * reprinting anything. `reviewUrl` is non-null in facts.json, so this page ships.
 */
import { REVIEW_URL } from "../data/business";
import { NAME_AR } from "../data/copy";
import { NAME } from "../data/business";

const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`قيّمنا — ${NAME_AR} / Rate ${NAME}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <meta http-equiv="refresh" content={`0; url=${REVIEW_URL}`} />
    <script is:inline define:vars={{ REVIEW_URL }}>
      location.replace(REVIEW_URL);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        text-align: center;
        background: #12100f;
        color: #f2ede6;
        font-family: system-ui, sans-serif;
        line-height: 1.7;
      }
      a {
        color: #f2ede6;
        background: #e11d33;
        padding: 0.9rem 1.6rem;
        border-radius: 3px;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <div>
      <p>جاري تحويلك لصفحة التقييم على جوجل…<br />Redirecting you to Google reviews…</p>
      <a href={REVIEW_URL}>اضغط هون / Tap here</a>
    </div>
  </body>
</html>
