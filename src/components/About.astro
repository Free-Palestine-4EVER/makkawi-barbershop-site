---
import { Image } from "astro:assets";
import { photos } from "../data/photos";
import { COPY, type Lang } from "../data/copy";
import { RATING, REVIEW_COUNT } from "../data/business";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
---

<section class="about" id="about">
  <div class="about__grid">
    <!-- Photo column bleeds off the inline-start edge and is cut on the
         same -3deg angle as the hero plate. -->
    <figure class="about__media" data-about-media>
      <div class="about__media-clip">
        <Image
          class="about__img"
          src={photos.interiorWide}
          alt={t.alts.interiorWide}
          widths={[600, 1000, 1500]}
          sizes="(min-width: 900px) 52vw, 100vw"
          loading="lazy"
          format="webp"
          quality={76}
        />
        <span class="about__wash" aria-hidden="true"></span>
      </div>
    </figure>

    <div class="about__body">
      <p class="eyebrow">{t.aboutEyebrow}</p>
      <h2 class="h2 about__h2">{t.aboutHeading}</h2>

      <div class="about__copy" data-about-copy>
        {
          t.aboutBody.map((line, i) => (
            <p class:list={["about__p", i === 0 && "about__p--lead"]}>{line}</p>
          ))
        }
      </div>

      <blockquote class="about__quote" data-about-quote>
        <span class="about__quote-mark" aria-hidden="true">”</span>
        {t.aboutQuote}
      </blockquote>

      <dl class="about__stats" data-about-stats>
        <div class="about__stat">
          <dt>{t.trustReviewsLabel}</dt>
          <dd class="numeral">{REVIEW_COUNT}</dd>
        </div>
        <div class="about__stat">
          <dt>{t.trustOutOf}</dt>
          <dd class="numeral about__stat--accent">{RATING}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    background: var(--bg);
    padding-block: clamp(3.5rem, 8vw, 7rem);
    overflow: clip;
  }

  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .about__media {
    margin: 0;
    position: relative;
  }
  .about__media-clip {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--surface);
    clip-path: polygon(0 0, 100% 3.2vw, 100% 100%, 0 calc(100% - 1.6vw));
  }
  .about__img {
    inline-size: 100%;
    block-size: 112%;
    object-fit: cover;
    will-change: translate;
  }
  .about__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        200deg,
        rgba(18, 16, 15, 0.55),
        rgba(18, 16, 15, 0) 55%
      ),
      linear-gradient(rgba(216, 166, 87, 0.1), rgba(225, 29, 51, 0.12));
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .about__body {
    padding-inline: var(--gutter);
    max-inline-size: 46rem;
  }
  .about__h2 {
    margin-block: 0.7rem clamp(1.2rem, 3vw, 2rem);
  }

  .about__copy {
    display: grid;
    gap: 1rem;
    max-inline-size: 40ch;
  }
  .about__p {
    color: var(--text-dim);
  }
  /* Editorial drop-cap on the opening sentence. */
  .about__p--lead {
    color: var(--text);
    font-size: clamp(1.1rem, 0.6vw + 1rem, 1.35rem);
    line-height: 1.55;
  }
  .about__p--lead::first-letter {
    float: inline-start;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 120%;
    font-size: 3.4em;
    line-height: 0.78;
    margin-inline-end: 0.09em;
    margin-block-start: 0.06em;
    color: var(--accent);
  }
  /* Arabic is cursive — a floated ::first-letter tears the opening letter out
     of its word ("صالون" -> "ص" + "الون"). So the Arabic lead gets its own
     editorial device instead: a heavier setting behind an accent rule. */
  :root[dir="rtl"] .about__p--lead::first-letter {
    float: none;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    margin: 0;
    color: inherit;
  }
  :root[dir="rtl"] .about__p--lead {
    font-weight: 600;
    font-size: clamp(1.2rem, 0.8vw + 1rem, 1.55rem);
    line-height: 1.7;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--accent);
  }

  .about__quote {
    position: relative;
    margin-block-start: clamp(1.8rem, 4vw, 2.8rem);
    padding-inline-start: 1.2rem;
    border-inline-start: 2px solid var(--accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(1.5rem, 2.2vw + 0.8rem, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    max-inline-size: 18ch;
  }
  :root[dir="rtl"] .about__quote {
    font-family: var(--font-body);
    font-stretch: normal;
    line-height: 1.4;
  }
  .about__quote-mark {
    color: var(--accent-2);
    font-size: 1.2em;
    line-height: 0;
    vertical-align: -0.15em;
    margin-inline-end: 0.05em;
  }

  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.8rem, 5vw, 3.5rem);
    margin-block-start: clamp(2rem, 4vw, 3rem);
    padding-block-start: 1.4rem;
    border-block-start: 1px solid var(--hairline);
  }
  .about__stat dt {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-block-end: 0.3rem;
  }
  :root[dir="rtl"] .about__stat dt {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .about__stat dd {
    margin: 0;
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
  }
  .about__stat--accent {
    color: var(--accent-2);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 52% 1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    .about__media {
      margin-inline-start: calc(var(--gutter) * -1);
    }
    .about__media-clip {
      aspect-ratio: 5 / 4;
      clip-path: polygon(0 0, 100% 4.5%, 100% 100%, 0 95.5%);
    }
    .about__body {
      padding-inline-end: var(--gutter);
      padding-inline-start: 0;
    }
  }

  /* Pre-reveal gate. Scoped to `.about:not(.is-in)` so that the instant the
     section is marked revealed the content is visible from CSS alone — an
     interrupted animation can never leave it stuck at opacity 0. */
  html.js .about:not(.is-in) [data-about-copy],
  html.js .about:not(.is-in) [data-about-quote],
  html.js .about:not(.is-in) [data-about-stats],
  html.js .about:not(.is-in) .about__media {
    opacity: 0;
  }
</style>

<script>
  import { animate, inView, scroll, stagger } from "motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const D = (n: number) => (reduce ? n * 0.4 : n);

  const section = document.querySelector<HTMLElement>(".about");
  const media = document.querySelector<HTMLElement>("[data-about-media]");
  const img = document.querySelector<HTMLElement>(".about__img");

  // Observe the SECTION, not each child, so the group animates together once.
  if (section) {
    inView(
      section,
      () => {
        section.classList.add("is-in"); // lift the CSS gate first
        if (media) {
          animate(
            media,
            { opacity: [0, 1], clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"] },
            { duration: D(1), ease: [0.16, 1, 0.3, 1] },
          );
        }
        const groups = document.querySelectorAll<HTMLElement>(
          "[data-about-copy], [data-about-quote], [data-about-stats]",
        );
        animate(
          groups,
          { opacity: [0, 1], transform: ["translateY(22px)", "translateY(0px)"] },
          { duration: D(0.75), delay: stagger(reduce ? 0.03 : 0.12), ease: "easeOut" },
        );
        const lines = document.querySelectorAll<HTMLElement>(".about__p");
        animate(
          lines,
          { opacity: [0.15, 1] },
          { duration: D(0.7), delay: stagger(reduce ? 0.02 : 0.09, { startDelay: 0.1 }) },
        );
      },
      { amount: 0.25 },
    );
  }

  // Photo drifts against the text as the section passes — transform only.
  if (img && section && !reduce) {
    const stopDrift = scroll(
      (progress: number) => {
        img.style.translate = `0 ${(0.5 - progress) * 60}px`;
      },
      { target: section, offset: ["start end", "end start"] },
    );
    window.addEventListener("pagehide", () => stopDrift(), { once: true });
  }
</script>
